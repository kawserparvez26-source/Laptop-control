# Laptop Control - Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# Required: Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Required: Telegram Bot Token
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Required: Comma-separated list of authorized Telegram user IDs
# Multiple users: 123456789,987654321,555555555
AUTHORIZED_USERS=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Log file path (created automatically if doesn't exist)
LOG_FILE=logs/laptop_control.log

# Optional: Audit log file path (for security events)
AUDIT_LOG_FILE=logs/audit.log

# Optional: Environment (development, staging, production)
ENVIRONMENT=development

# Optional: Emergency stop file (if this file exists, system stops all operations)
EMERGENCY_STOP_FILE=/tmp/laptop-control.stop
